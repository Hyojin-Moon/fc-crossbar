# Supabase 프로젝트 설정
# Supabase Dashboard > Project Settings > Data API 에서 확인할 수 있다.
#
# 사용법:
#   cp .env.example .env
#   값을 채운 뒤 개발 서버를 재시작한다 (npx expo start -c)
#
# 주의:
#  - EXPO_PUBLIC_ 접두사가 붙은 값만 앱 코드에서 읽을 수 있다.
#  - EXPO_PUBLIC_ 값은 빌드된 APK 안에 그대로 들어간다. anon key 는 공개돼도 되는
#    값이지만(보호는 RLS 가 담당한다), service_role key 는 절대 여기에 넣지 않는다.

# URL 은 도메인까지만. /rest/v1 같은 경로를 붙이면 안 된다 (supabase-js 가 알아서 붙인다)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx
